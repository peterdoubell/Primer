  "investigations": {
    "ra.ultrasound-thyroid": {
      "thyroid-nodule": [
        {
          "calculator_id": "acr_tirads_2017",
          "label": "ACR TI-RADS 2017",
          "trigger_any": [
            "nodule"
          ],
          "inputs": {
            "adult_applicability_confirmed": {
              "sources": [
                {
                  "finding_id": "adult",
                  "section_id": "patient-group",
                  "value": true
                },
                {
                  "finding_id": "child",
                  "section_id": "patient-group",
                  "value": false
                }
              ]
            },
            "composition": {
              "sources": [
                {
                  "finding_id": "composition",
                  "slot_id": "slot-1",
                  "map": {
                    "cystic or almost completely cystic": "cystic_or_almost_cystic",
                    "spongiform": "spongiform",
                    "mixed cystic and solid": "mixed_cystic_solid",
                    "solid or almost completely solid": "solid_or_almost_solid"
                  }
                }
              ]
            },
            "echogenicity": {
              "sources": [
                {
                  "finding_id": "echogenicity",
                  "slot_id": "slot-1",
                  "map": {
                    "anechoic": "anechoic",
                    "hyperechoic or isoechoic": "hyper_or_isoechoic",
                    "hypoechoic": "hypoechoic",
                    "very hypoechoic": "very_hypoechoic"
                  }
                }
              ]
            },
            "shape": {
              "sources": [
                {
                  "finding_id": "shape",
                  "slot_id": "slot-1",
                  "map": {
                    "wider-than-tall": "wider_than_tall",
                    "taller-than-wide": "taller_than_wide"
                  }
                }
              ]
            },
            "margin": {
              "sources": [
                {
                  "finding_id": "margin",
                  "slot_id": "slot-1",
                  "map": {
                    "smooth": "smooth",
                    "ill-defined": "ill_defined",
                    "lobulated or irregular": "lobulated_or_irregular",
                    "extrathyroidal extension": "extrathyroidal_extension"
                  }
                }
              ]
            },
            "echogenic_foci": {
              "sources": [
                {
                  "finding_id": "echogenic-foci",
                  "slot_id": "slot-1",
                  "map": {
                    "no echogenic foci": [
                      "none"
                    ],
                    "large comet-tail artefacts only": [
                      "large_comet_tail"
                    ],
                    "macrocalcification only": [
                      "macrocalcifications"
                    ],
                    "peripheral rim calcification only": [
                      "peripheral_rim"
                    ],
                    "punctate echogenic foci only": [
                      "punctate"
                    ],
                    "macrocalcification and peripheral rim calcification": [
                      "macrocalcifications",
                      "peripheral_rim"
                    ],
                    "macrocalcification and punctate echogenic foci": [
                      "macrocalcifications",
                      "punctate"
                    ],
                    "peripheral rim calcification and punctate echogenic foci": [
                      "peripheral_rim",
                      "punctate"
                    ],
                    "macrocalcification and peripheral rim calcification and punctate echogenic foci": [
                      "macrocalcifications",
                      "peripheral_rim",
                      "punctate"
                    ]
                  }
                }
              ]
            },
            "size_mm": {
              "sources": [
                {
                  "finding_id": "dimensions",
                  "slot_id": "slot-1"
                },
                {
                  "finding_id": "dimensions",
                  "slot_id": "slot-2"
                },
                {
                  "finding_id": "dimensions",
                  "slot_id": "slot-3"
                }
              ],
              "aggregate": "max",
              "all_required": true
            }
          },
          "skip_when": [
            {
              "input": "adult_applicability_confirmed",
              "values": [
                false
              ],
              "message": "ACR TI-RADS adult classification is not applied to this child."
            }
          ]
        }
      ]
    },
