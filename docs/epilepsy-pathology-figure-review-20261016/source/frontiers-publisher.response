ics-and-brain-health",{"id":173,"name":174,"slug":175},19,"Neurogenomics","neurogenomics",{"id":177,"name":178,"slug":179},31,"Neuromorphic Engineering","neuromorphic-engineering",{"id":181,"name":182,"slug":183},26,"Neuropharmacology","neuropharmacology",{"id":185,"name":186,"slug":187},23,"Neuroprosthetics","neuroprosthetics",{"id":189,"name":190,"slug":191},3817,"Neuroscience Data","neuroscience-data",{"id":193,"name":194,"slug":195},3022,"Neuroscience Methods and Techniques","neuroscience-methods-and-techniques",{"id":197,"name":198,"slug":199},41,"Perception Science","perception-science",{"id":201,"name":202,"slug":203},1409,"Sleep and Circadian Rhythms","sleep-and-circadian-rhythms",{"id":205,"name":206,"slug":207},2450,"Translational Neuroscience","translational-neuroscience",{"id":209,"name":210,"slug":211},2411,"Visual Neuroscience","visual-neuroscience","Sections",[214,238],{"title":215,"links":216},"Scope",[217,220,223,226,229,232,235],{"text":218,"url":219,"target":27,"ariaLabel":28},"Field chief editors","https://www.frontiersin.org/journals/neuroscience/about#about-editors",{"text":221,"url":222,"target":27,"ariaLabel":28},"Mission and scope","https://www.frontiersin.org/journals/neuroscience/about#about-scope",{"text":224,"url":225,"target":27,"ariaLabel":28},"Facts","https://www.frontiersin.org/journals/neuroscience/about#about-facts",{"text":227,"url":228,"target":27,"ariaLabel":28},"Journal sections","https://www.frontiersin.org/journals/neuroscience/about#about-submission",{"text":230,"url":231,"target":27,"ariaLabel":28},"Open access statement","https://www.frontiersin.org/journals/neuroscience/about#about-open",{"text":233,"url":234,"target":27,"ariaLabel":28},"Copyright statement","https://www.frontiersin.org/journals/neuroscience/about#copyright-statement",{"text":236,"url":237,"target":27,"ariaLabel":28},"Quality","https://www.frontiersin.org/journals/neuroscience/about#about-quality",{"title":239,"links":240},"For authors",[241,244,247,250,2