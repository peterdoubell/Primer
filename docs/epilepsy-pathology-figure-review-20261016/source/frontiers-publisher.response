e":344,"hiddenText":13},{"text":347,"url":348,"target":86,"ariaLabel":28},"Frontiers Twitter","https://twitter.com/frontiersin","Twitter",{"link":351,"type":341,"color":342,"icon":354,"size":344,"hiddenText":13},{"text":352,"url":353,"target":86,"ariaLabel":28},"Frontiers LinkedIn","https://www.linkedin.com/company/frontiers","LinkedIn",{"link":356,"type":341,"color":342,"icon":359,"size":344,"hiddenText":13},{"text":357,"url":358,"target":86,"ariaLabel":28},"Frontiers Instagram","https://www.instagram.com/frontiersin_","Instagram","Frontiers Media SA. All rights reserved.","https://www.frontiersin.org/legal/terms-and-conditions","https://www.frontiersin.org/legal/privacy-policy","https://www.frontiersin.org/about/accessibility-statement",{},false,{"__typename":367,"identifier":124,"name":125,"slug":126,"banner":368,"description":412,"mission":413,"palette":414,"impactFactor":415,"citeScore":416,"citations":417,"showTagline":13,"twitter":418},"Journal",[369],{"id":370,"src":371,"name":372,"type":373,"width":374,"height":375,"idHash":376,"archive":377,"brandId":378,"limited":377,"fileSize":379,"isPublic":124,"original":380,"copyright":19,"extension":381,"thumbnails":383,"dateCreated":391,"description":19,"orientation":392,"userCreated":393,"watermarked":377,"dateModified":391,"datePublished":394,"ecsArchiveFiles":395,"propertyOptions":396,"property_Channel":401,"property_Sub-Type":403,"property_Asset_Type":405,"activeOriginalFocusPoint":407,"property_Office_Department":410},"27A044CC-44D1-4E5E-A886893A3FE656F4","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/27A044CC-44D1-4E5E-A886893A3FE656F4/webimage-731DCAD7-7D53-4C7A-ABED6B270359A65F.png","FNINS_Main Visual_Purple_Website","image",6788,4865,"18e4eb8ad56b508b",0,"22C10171-81B3-4DA6-99342F272A32E8BB",12200641,"https://brand.frontiersin.org/m/18e4eb8ad56b508b/original/FNINS_Main-Visual_Purple_Website.jpg",[382],"jpg",{"mini":384,"thul":385,"webimage":371,"Guidelines":386,"WebsiteJpg_XL":387,"WebsiteWebP_L":388,"WebsiteWebP_M":389,"WebsiteWebP_XL":390},"https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/27A044CC-44D1-4E5E-A886893A3FE656F4/mini-64E6EA95-B7B1-4005-AB72061E18A6F830.png","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/27A044CC-44D1-4E5E-A886893A3FE656F4/thul-38432C11-11F0-4DA5-B8C0EBF0A1603722.png","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/27A044CC-44D1-4E5E-A886893A3FE656F4/A72D78D9-73CD-4C75-910FB7C0D04825C0/Guidelines-FNINS_Main Visual_Purple_Website.png","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/27A044CC-44D1-4E5E-A886893A3FE656F4/A72D78D9-73CD-4C75-910FB7C0D04825C0/WebsiteJpg_XL-FNINS_Main Visual_Purple_Website.jpg","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/27A044CC-44D1-4E5E-A886893A3FE656F4/A72D78D9-73CD-4C75-910FB7C0D04825C0/WebsiteWebP_L-FNINS_Main Visual_Purple_Website.webp","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/27A044CC-44D1-4E5E-A886893A3FE656F4/A72D78D9-73CD-4C75-910FB7C0D04825C0/WebsiteWebP_M-FNINS_Main Visual_Purple_Website.webp","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/27A044CC-44D1-4E5E-A886893A3FE656F4/A72D78D9-73CD-4C75-910FB7C0D04825C0/WebsiteWebP_XL-FNINS_Main Visual_Purple_Website.webp","2022-06-27T10:00:29Z","landscape","Caroline Sutter","2022-06-27T09:27:09Z",[],[397,398,399,400],"414FB2D4-2283-43FD-BE14E534ECA67928","6C18119B-14BD-4951-B437696F4357BD33","7C692885-DB25-4858-B1FB4FF47B241E9B","D88C0047-EC30-4506-A7DF28A4D765E1CF",[402],"frontiersin_org",[404],"Main_Visual",[406],"Photography",{"x":408,"y":409},3394,2433,[411],"Publishing","One of the world's most cited neuroscience journals, covering brain structure, function and disorders from cells to systems and behavior.","\u003Cp>Frontiers in Neuroscience is a leading multidisciplinary journal that publishes research across a wide range of spectrum of specialities and disciplines in the field of neuroscience.\u003C/p>\n\n\u003Cp>Led by Field Chief Editor, Professor Idan Segev (Hebrew University of Jerusalem, Israel) and indexed in PubMed Central (PMC), Web of Science (SCIE), and Scopus among others, the journal provides a comprehensive understanding of brain functions, from genes to behavior, and aims to tighten the links between various domains of neuroscience and advance conceptual and technological developments in the field.\u003C/p>\n\n\u003Cp>Topics of interest include, but are not limited to:\u003C/p>\n\n\u003Cul>\n  \u003Cli>autonomic function and brain energy homeostasis\u003C/li>\n  \u003Cli>neural development and degeneration\u003C/li>\n  \u003Cli>neuroengineering including neuromorphic engineering and neuroprosthetics\u003C/li>\n  \u003Cli>novel brain imaging methods from the subcellular level (e.g. genetically encoded voltage- and ions indicators) to the whole brain level (e.g. large-scale micro-electrode arrays and direct imaging of neuronal activity at the cellular level by fMRI)\u003C/li>\n  \u003Cli>sensory perception and cognition.\u003C/li>\n  \u003Cli>translational neuroscience\u003C/li>\n\u003C/ul>\n\n\u003Cp>Studies on the convergence of novel molecular and optical techniques, and developments in anatomical methods, both at the whole-brain level (“connectome”) and the local circuit and synaptic level (“connectomics”) are of particular interest.  Approaches that allow us to link the structure of local circuits at specific brain regions to function are encouraged.\u003C/p>\n\n\u003Cp>The journal also welcomes submissions which support and advance the UN’s Sustainable Development Goals (SDGs), notably SDG 3: to ensure healthy lives and promote well-being for all at all ages. Studies that propose ways to promote mental health and prevent neurodegenerative diseases are of particular interest.\u003C/p>\n\n\u003Cp>Studies that focus on clinical trials, medical treatments, or the application of medical techniques without neuroscientific foundations are not within the scope of the journal. Similarly, studies that primarily investigate the effects of traditional medicine on health conditions, without exploring the underlying neurological mechanisms, fall outside of the journal scope.\u003C/p>\n\n\u003Cp>Frontiers’ journals require that manuscripts primarily comprising computational studies of public data, must include appropriate validation. Please refer to the \u003Ca href=\"https://www.frontiersin.org/guidelines/policies-and-publication-ethics#standards-for-research-methodology:~:text=complaints%20and%20allegations.-,Standards%20for%20research%20methodology,-Experiments\">Frontiers Standards for research methodology policy\u003C/a>, for more information. Manuscripts not adhering to these standards will not be considered.\u003Cp>\n\n\u003Cp>Frontiers in Neuroscience is committed to advancing developments in the field by allowing unrestricted access to research articles and communicating scientific knowledge to researchers and the public alike, to enhance scientific understanding and repairing the brain.\u003C/p>","purple","4.3","6.8","472158","@FrontNeurosci",{"id":124,"name":125,"slug":126,"abbreviation":420,"isOnline":13,"isOpenForSubmissions":-1,"impactFactor":421,"citeScore":422},"fnins",4,7.4,{"displayTitlePillLabels":13,"displayRelatedArticlesBox":13,"showEditors":13,"showReviewers":13,"showLoopImpactLink":13,"enableFigshare":365},{"isPublic":365,"allowCompanyUsers":365,"whiteListEmails":425,"enableAllJournals":365,"whiteListJournals":426},[],[],{"spaceId":124,"name":124,"availableJournalPages":428,"announcement":432,"useJournalPalettes":365},[272,277,274,429,430,431],"volumes","about","community-reviewers",{"__typename":433,"sys":434,"preHeader":436,"title":437,"description":438,"image":439,"link":513},"Announcement",{"id":435},"30jAeTjZfu9FwrF5jqYs9f","Our quality","Expert judgment makes science stronger","Behind every published article stand expert reviewers safeguarding science. Discover our rigorous approach to peer review.",[440],{"id":441,"src":442,"name":443,"tags":444,"type":373,"width":494,"height":495,"archive":377,"brandId":378,"limited":377,"fileSize":496,"isPublic":124,"original":497,"copyright":28,"extension":498,"thumbnails":499,"dateCreated":507,"description":443,"orientation":392,"watermarked":377,"dateModified":508,"selectedFile":28,"datePublished":509,"streamingLinks":510,"videoPreviewURLs":511,"textMetaproperties":512},"E8101B5E-CD70-402C-B234D8C42CD1D053","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/thumbnail/webimage-Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass","Doctor making notes in hospital, corona virus concept. Shot through glass.",[445,446,447,448,449,450,451,452,453,454,455,456,457,458,459,460,461,462,463,464,465,466,467,468,469,470,471,472,473,474,475,476,477,478,479,480,481,482,483,484,485,486,487,488,489,490,491,492,493],"global","professional","pandemic","conference","contagious","pneumonia","respiratory","medical","glass","exhausted","outbreak","corona","virus","making notes","writing","DOCTOR","contamination","training","Risk","Coronavirus","Science","warning","Hospital","health","close-up","infection","research","safety","prevention","concept","danger","Indoors","Disease","fever","scientist","flu","protection","men","viral","copy space","shot","Clinic","illness","healthcare","cure","seminar","epidemic","treatment","working on",4928,3280,14062390,"https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.jpg",[382],{"mini":500,"thul":501,"original":497,"webimage":442,"Guidelines":502,"WebsiteJpg_XL":503,"WebsiteWebP_L":504,"WebsiteWebP_M":505,"WebsiteWebP_XL":506},"https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/thumbnail/mini-Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/thumbnail/thul-Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/Guidelines/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.png","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/WebsiteJpg_XL/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.jpg","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/WebsiteWebP_L/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.webp","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/WebsiteWebP_M/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.webp","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/WebsiteWebP_XL/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.webp","2022-05-10T11:52:42Z","2026-02-11T15:34:30Z","2022-05-11T12:46:58Z",{},[],[],{"text":514,"url":67,"target":27,"ariaLabel":28},"Learn about peer review",{"loggedUserInfo":-1},{"currentArticle":517,"isPreviewPage":365,"hasSupplementalData":365,"showCrossmarkWidget":13,"articleTemplate":626,"currentArticlePageMetaInfo":627,"xmlParsedArticleContent":727,"xmlParsingError":-1},{"id":518,"doi":519,"title":520,"acceptanceDate":521,"receptionDate":522,"publicationDate":523,"lastModifiedDate":524,"isPublished":13,"abstract":525,"researchTopic":526,"articleType":532,"stage":535,"keywords":537,"authors":544,"editors":557,"reviewers":568,"journal":585,"section":592,"impactMetrics":594,"volume":597,"articleVolume":598,"relatedArticles":599,"isPublishedV2":365,"contents":600,"laySummary":19,"files":601},699176,"10.3389/fnins.2021.699176","Making the Invisible Visible: Advanced Neuroimaging Techniques in Focal Epilepsy",["Date","2021-06-28T09:39:36.000Z"],["Date","2021-04-23T01:17:19.000Z"],["Date","2021-07-27T00:00:00.000Z"],["Date","2026-10-16T06:05:23.327Z"],"It has been a clinically important, long-standing challenge to accurately localize epileptogenic focus in drug-resistant focal epilepsy because more intensive intervention to the detected focus, including resection neurosurgery, can provide significant seizure reduction. In addition to neurophysiological examinations, neuroimaging plays a crucial role in the detection of focus by providing morphological and neuroanatomical information. On the other hand, epileptogenic lesions in the brain may sometimes show only subtle or even invisible abnormalities on conventional MRI sequences, and thus efforts have been made for better visualization and improved detection of the focus lesions. Recent advance in neuroimaging has been attracting attentions because of the potentials to better visualize the epileptogenic lesions as well as provide novel information about the pathophysiology of epilepsy. While the progress of newer neuroimaging techniques, including the non-Gaussian diffusion model and arterial spin labeling, could non-invasively detect decreased neurite parameters or hypoperfusion within the focus lesions, advances in analytic technology may also provide usefulness for both focus detection and understanding of epilepsy. There have been an increasing number of clinical and experimental applications of machine-learning and network analysis in the field of epilepsy. This review article will shed light on recent advances in neuroimaging for focal epilepsy, including both technical progress of images and newer analytical methodologies and discuss about the potential usefulness in clinical practice.",{"id":527,"title":528,"articlesCount":529,"isMagazinePage":13,"slug":530,"isOpenForSubmission":365,"views":531},17289,"Advances in the Imaging Techniques of Radiologically subtle CNS Disorders",13,"advances-in-the-imaging-techniques-of-radiologically-subtle-cns-disorders",119014,{"id":533,"name":534},27,"Review",{"id":536,"name":19},18,[538,539,540,541,542,543],"focal epilepsy","Magnetic Resonance Imaging","Advanced neuroimaging","structural neuroimaging","diffusion neuroimaging","Functional Neuroimaging",[545],{"id":546,"firstName":547,"middleName":19,"lastName":548,"givenNames":549,"isCorresponding":365,"isProfilePublic":13,"userId":546,"email":-1,"affiliations":550},444698,"Daichi","Sone","Daichi ",[551,554],{"organizationName":552,"countryName":553,"cityName":19,"stateName":19,"zipCode":19},"Department of Psychiatry, The Jikei University School of Medicine","Japan",{"organizationName":555,"countryName":556,"cityName":19,"stateName":19,"zipCode":19},"Department of Clinical and Experimental Epilepsy, UCL Institute of Neurology","United Kingdom",[558],{"id":559,"firstName":560,"middleName":561,"lastName":562,"givenNames":563,"isCorresponding":365,"isProfilePublic":13,"userId":559,"email":-1,"affiliations":564},1118538,"Ahmad","Raza","Khan","Ahmad  Raza",[565],{"organizationName":566,"countryName":567,"cityName":19,"stateName":19,"zipCode":19},"National Brain Research Centre (NBRC)","India",[569,577],{"id":570,"firstName":571,"middleName":19,"lastName":572,"givenNames":573,"isCorresponding":365,"isProfilePublic":13,"userId":570,"email":-1,"affiliations":574},1012836,"Vivek","Tiwari","Vivek ",[575],{"organizationName":576,"countryName":567,"cityName":19,"stateName":19,"zipCode":19},"Indian Institute of Science Education and Research Berhampur (IISER)",{"id":578,"firstName":579,"middleName":19,"lastName":580,"givenNames":581,"isCorresponding":365,"isProfilePublic":13,"userId":578,"email":-1,"affiliations":582},1326641,"Shilpi","Modi","Shilpi ",[583],{"organizationName":584,"countryName":567,"cityName":19,"stateName":19,"zipCode":19},"Institute of Nuclear Medicine & Allied Sciences (DRDO)",{"id":124,"slug":126,"name":125,"shortName":586,"electronicISSN":587,"field":588,"specialtyId":28,"journalSectionPaths":590},"Front. Neurosci.","1662-453X",{"id":589,"domainId":124},55,[591],{"section":592},{"id":137,"name":138,"slug":139,"specialtyId":593},1304,{"views":595,"downloads":596,"citations":536},18861,3489,15,"Volume 15 - 2021",[],{"titleHtml":19,"fullTextHtml":19,"menuHtml":19},[602,607,613,616,622],{"name":603,"fileServerPackageEntryId":19,"fileServerId":604,"fileServerVersionNumber":124,"type":605},"EPUB.epub","699176/epub",{"code":606,"name":606},"EPUB",{"name":608,"fileServerPackageEntryId":609,"fileServerId":610,"fileServerVersionNumber":124,"type":611},"fnins-15-699176.pdf","fnins-15-699176/fnins-15-699176.pdf","699176/pubmed-zip",{"code":612,"name":612},"PDF",{"name":608,"fileServerPackageEntryId":19,"fileServerId":614,"fileServerVersionNumber":124,"type":615},"699176/publishers-proof/pdf",{"code":612,"name":612},{"name":617,"fileServerPackageEntryId":618,"fileServerId":610,"fileServerVersionNumber":124,"type":619},"fnins-15-699176.xml","fnins-15-699176/fnins-15-699176.xml",{"code":620,"name":621},"NLM_XML","XML",{"name":623,"fileServerPackageEntryId":19,"fileServerId":624,"fileServerVersionNumber":124,"type":625},"Provisional PDF.pdf","699176/provisional-pdf",{"code":612,"name":612},"v4",{"title":628,"link":629,"meta":633,"script":716},"Frontiers | Making the Invisible Visible: Advanced Neuroimaging Techniques in Focal Epilepsy",[630],{"rel":631,"href":632},"canonical","https://www.frontiersin.org/journals/neuroscience/articles/10.3389/fnins.2021.699176/full",[634,637,640,642,645,649,652,656,659,662,665,667,669,671,673,675,678,681,683,686,688,690,693,696,699,702,705,709,713],{"hid":635,"property":635,"name":635,"content":636},"description","It has been a clinically important, long-standing challenge to accurately localize epileptogenic focus in drug-resistant focal epilepsy because more intensiv...",{"hid":638,"property":638,"name":639,"content":628},"og:title","title",{"hid":641,"property":641,"name":635,"content":636},"og:description",{"hid":643,"name":643,"content":644},"keywords","focal epilepsy,Magnetic Resonance Imaging,Advanced neuroimaging,structural neuroimaging,diffusion neuroimaging,Functional Neuroimaging",{"hid":646,"property":646,"name":647,"content":648},"og:site_name","site_name","Frontiers",{"hid":650,"property":650,"name":373,"content":651},"og:image","https://www.frontiersin.org/api/ipx/w=1200&f=png/https://www.frontiersin.org/files/Articles/699176/fnins-15-699176-HTML/image_m/fnins-15-699176-g001.jpg",{"hid":653,"property":653,"name":654,"content":655},"og:type","type","article",{"hid":657,"property":657,"name":658,"content":632},"og:url","url",{"hid":660,"name":660,"content":661},"twitter:card","summary_large_image",{"hid":663,"name":663,"content":664},"citation_volume","15",{"hid":666,"name":666,"content":125},"citation_journal_title",{"hid":668,"name":668,"content":648},"citation_publisher",{"hid":670,"name":670,"content":586},"citation_journal_abbrev",{"hid":672,"name":672,"content":587},"citation_issn",{"hid":674,"name":674,"content":519},"citation_doi",{"hid":676,"name":676,"content":677},"citation_firstpage","699176",{"hid":679,"name":679,"content":680},"citation_language","English",{"hid":682,"name":682,"content":520},"citation_title",{"hid":684,"name":684,"content":685},"citation_keywords","focal epilepsy; Magnetic Resonance Imaging; Advanced neuroimaging; structural neuroimaging; diffusion neuroimaging; Functional Neuroimaging",{"hid":687,"name":687,"content":525},"citation_abstract",{"hid":689,"name":689,"content":534},"citation_article_type",{"hid":691,"name":691,"content":692},"citation_pdf_url","https://www.frontiersin.org/journals/neuroscience/articles/10.3389/fnins.2021.699176/pdf",{"hid":694,"name":694,"content":695},"citation_xml_url","https://www.frontiersin.org/journals/neuroscience/articles/10.3389/fnins.2021.699176/xml",{"hid":697,"name":697,"content":698},"citation_fulltext_world_readable","yes",{"hid":700,"name":700,"content":701},"citation_online_date","2021/06/28",{"hid":703,"name":703,"content":704},"citation_publication_date","2021/07/27",{"hid":706,"name":707,"content":708},"citation_author_0","citation_author","Sone, Daichi ",{"hid":710,"name":711,"content":712},"citation_author_institution_0","citation_author_institution","Department of Psychiatry, The Jikei University School of Medicine, Japan",{"hid":714,"name":714,"content":715},"dc.identifier","doi:10.3389/fnins.2021.699176",[717,720,723,725],{"src":718,"body":13,"type":719,"async":13},"https://cdnjs.cloudflare.com/polyfill/v3/polyfill.min.js?features=es6","text/javascript",{"innerHTML":721,"type":722},"MathJax.Hub.Config({\"CommonHTML\":{linebreaks:{automatic:true,width:\"container\"}}});","text/x-mathjax-config",{"src":724,"body":13,"type":719,"async":13},"https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.1/MathJax.js?config=TeX-MML-AM_CHTML",{"src":726,"body":13,"type":719,"async":13},"https://crossmark-cdn.crossref.org/widget/v2.0/widget.js",{"journal":728,"doi":519,"articleType":534,"title":730,"authors":732,"onBehalfOf":19,"affiliations":737,"authorNotes":744,"publicationDate":778,"acceptedDate":779,"receivedDate":780,"correctedDate":19,"retractedDate":19,"volume":597,"elocationId":518,"permissions":781,"keywords":800,"relatedArticles":816,"abstractContent":817,"bodyContent":825,"appendixContent":2284,"statements":2285,"referenceLists":2337,"references":13604,"otherBackSections":23861,"figures":23862,"toc":23976,"correspondingAuthors":23997},{"title":125,"abbreviation":586,"issn":587,"publisherName":729},"Frontiers Media S.A.",[731],{"#text":520},[733],{"surname":548,"givenNames":547,"suffix":19,"affiliationsIndexes":734,"isCorresponding":13,"equalContrib":365,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":736,"onBehalfOf":19},[124,735],2,"http://loop.frontiersin.org/people/444698/overview",[738,741],{"index":124,"baseText":19,"institution":552,"country":553,"address":739,"textContent":740},"Tokyo","Department of Psychiatry, The Jikei University School of Medicine, Tokyo, Japan",{"index":735,"baseText":19,"institution":555,"country":556,"address":742,"textContent":743},"London","Department of Clinical and Experimental Epilepsy, UCL Institute of Neurology, London, United Kingdom",{"editedBy":745,"editedByContent":748,"reviewedBy":757,"reviewedByContent":760,"approvedBy":767,"approvedByContent":768,"correspondence":769,"equalContribution":770,"presentAddress":19,"other":771},[746],{"textContent":747},"Edited by: Ahmad Raza Khan, Centre of Bio-Medical Research (CBMR), India",[749,751,755],{"#text":750},"\n          ",{"p":752},[753],{"#text":754}," Ahmad Raza Khan, Centre of Bio-Medical Research (CBMR), India",{"#text":756},"\n        ",[758],{"textContent":759},"Reviewed by: Vivek Tiwari, Indian Institute of Science, India; Shilpi Modi, Institute of Nuclear Medicine & Allied Sciences (DRDO), India",[761,762,766],{"#text":750},{"p":763},[764],{"#text":765}," Vivek Tiwari, Indian Institute of Science, India; Shilpi Modi, Institute of Nuclear Medicine & Allied Sciences (DRDO), India",{"#text":756},[],[],"*Correspondence: Daichi Sone, ZC5zb25lQHVjbC5hYy51aw==",[],[772,773,777],{"#text":750},{"p":774},[775],{"#text":776},"This article was submitted to Brain Imaging Methods, a section of the journal Frontiers in Neuroscience",{"#text":756},"2021-07-27","2021-06-28","2021-04-23",{"copyrightStatement":782,"copyrightYear":783,"copyrightHolder":548,"licenseUrl":784,"licenseText":785},"Copyright © 2021 Sone.",2021,"http://creativecommons.org/licenses/by/4.0/",[786,787,799],{"#text":750},{"p":788},[789,791,797],{"#text":790},"This is an open-access article distributed under the terms of the ",{"ext-link":792,":@":795},[793],{"#text":794},"Creative Commons Attribution License (CC BY)",{"@_ext-link-type":796,"@_xlink:href":784},"uri",{"#text":798},". The use, distribution or reproduction in other forums is permitted, provided the original author(s) and the copyright owner(s) are credited and that the original publication in this journal is cited, in accordance with accepted academic practice. No use, distribution or reproduction is permitted which does not comply with these terms.",{"#text":756},[801,803,806,809,811,813],[802],{"#text":538},[804],{"#text":805},"magnetic resonance imaging",[807],{"#text":808},"advanced neuroimaging",[810],{"#text":541},[812],{"#text":542},[814],{"#text":815},"functional neuroimaging",[],[818,819,823],{"#text":756},{"p":820},[821],{"#text":822},"It has been a clinically important, long-standing challenge to accurately localize epileptogenic focus in drug-resistant focal epilepsy because more intensive intervention to the detected focus, including resection neurosurgery, can provide significant seizure reduction. In addition to neurophysiological examinations, neuroimaging plays a crucial role in the detection of focus by providing morphological and neuroanatomical information. On the other hand, epileptogenic lesions in the brain may sometimes show only subtle or even invisible abnormalities on conventional MRI sequences, and thus, efforts have been made for better visualization and improved detection of the focus lesions. Recent advance in neuroimaging has been attracting attention because of the potentials to better visualize the epileptogenic lesions as well as provide novel information about the pathophysiology of epilepsy. While the progress of newer neuroimaging techniques, including the non-Gaussian diffusion model and arterial spin labeling, could non-invasively detect decreased neurite parameters or hypoperfusion within the focus lesions, advances in analytic technology may also provide usefulness for both focus detection and understanding of epilepsy. There has been an increasing number of clinical and experimental applications of machine learning and network analysis in the field of epilepsy. This review article will shed light on recent advances in neuroimaging for focal epilepsy, including both technical progress of images and newer analytical methodologies and discuss about the potential usefulness in clinical practice.",{"#text":824},"\n      ",[826,828,937,938,1207,1208,1269,1270,1421,1422,1617,1618,1767,1768,1977,1978,2039,2040,2098,2099,2172,2173,2216,2217,2232,2233,2248,2249,2265,2266,2282],{"#text":827},"\n    ",{"sec":829,":@":935,"anchorId":936},[830,831,835,836,894,895,929,930,934],{"#text":824},{"title":832},[833],{"#text":834},"Introduction",{"#text":824},{"p":837},[838,840,847,849,855,857,861,863,869,870,876,878,884,886,892],{"#text":839},"Epilepsy is a common chronic brain disease, which affects around 50 million people all over the world (",{"xref":841,":@":844},[842],{"#text":843},"Leonardi and Ustun, 2002",{"@_ref-type":845,"@_rid":846},"bibr","B41",{"#text":848},"; ",{"xref":850,":@":853},[851],{"#text":852},"GBD 2016 Epilepsy Collaborators, 2019",{"@_ref-type":845,"@_rid":854},"B22",{"#text":856},"). The burden of epilepsy includes recurrent seizures, their physical and psychosocial problems, and various comorbidities (",{"xref":858,":@":860},[859],{"#text":852},{"@_ref-type":845,"@_rid":854},{"#text":862},"). While seizures can be controlled by anti-seizure medicine in over 60% of patients with epilepsy (",{"xref":864,":@":867},[865],{"#text":866},"Kwan and Brodie, 2000",{"@_ref-type":845,"@_rid":868},"B39",{"#text":848},{"xref":871,":@":874},[872],{"#text":873},"Chen et al., 2018b",{"@_ref-type":845,"@_rid":875},"B11",{"#text":877},"), the rest of them experience drug-resistant seizures, which may result in poorer quality of life (",{"xref":879,":@":882},[880],{"#text":881},"Kubota and Awaya, 2010",{"@_ref-type":845,"@_rid":883},"B36",{"#text":885},"). Epilepsy surgery is a well-established option to remediate patients with drug-resistant epilepsy, and particularly accurate localization of epileptogenic focus has a key role for the successful surgical resection in focal epilepsy (",{"xref":887,":@":890},[888],{"#text":889},"Rathore and Radhakrishnan, 2015",{"@_ref-type":845,"@_rid":891},"B54",{"#text":893},").",{"#text":824},{"p":896},[897,899,905,907,913,915,921,923,927],{"#text":898},"Neuroimaging is an essential examination for epilepsy, and one of its major roles is to visualize epileptogenic lesions, particularly in patients with drug-resistant focal seizures (",{"xref":900,":@":903},[901],{"#text":902},"Bernasconi et al., 2019",{"@_ref-type":845,"@_rid":904},"B6",{"#text":906},"). However, a part of cases with focal epilepsy show visually normal MRI, which is called “MRI-negative” epilepsy (",{"xref":908,":@":911},[909],{"#text":910},"So and Lee, 2014",{"@_ref-type":845,"@_rid":912},"B66",{"#text":914},"), and the proportion of MRI-negative cases was supposed to be up to 30% in temporal lobe epilepsy (",{"xref":916,":@":919},[917],{"#text":918},"Muhlhofer et al., 2017",{"@_ref-type":845,"@_rid":920},"B52",{"#text":922},"). Since unsuccessful localization of focus by MRI may lead to poorer surgical seizure outcome (",{"xref":924,":@":926},[925],{"#text":910},{"@_ref-type":845,"@_rid":912},{"#text":928},"), accurate visualization of epileptogenic lesions by neuroimaging techniques has been a long-standing challenge in epilepsy.",{"#text":824},{"p":931},[932],{"#text":933},"Thus, the current review will shed light on recent advanced neuroimaging techniques for focus detection as well as conventional standard and quantitative analysis.",{"#text":827},{"@_id":936},"S1",{"#text":827},{"sec":939,":@":1205,"anchorId":1206},[940,941,945,946,996,997,1058,1059,1082,1083,1141,1142,1180,1181,1204],{"#text":824},{"title":942},[943],{"#text":944},"Conventionally “Visible” Structural Lesions",{"#text":824},{"p":947},[948,950,957,959,963,965,971,972,978,980,986,988,994],{"#text":949},"Even though a lot of quantitative methodologies have been developed, visual inspection is still an important and standard approach for focus detection. ",{"xref":951,":@":954},[952],{"#text":953},"Figure 1",{"@_ref-type":955,"@_rid":956},"fig","F1",{"#text":958}," presents an overview of conventionally visible epileptogenic lesions, including hippocampal sclerosis, focal cortical dysplasia and other malformation of cortical development, neoplasms, vascular malformations, and cerebrovascular diseases. Before discussing about MRI-negative epilepsy, epileptologists should be aware of these common epileptogenic lesions. Particularly, the two common etiologies, i.e., hippocampal sclerosis and focal cortical dysplasia, may need careful and specific attention for detection, as only subtle abnormalities may sometimes be found (",{"xref":960,":@":962},[961],{"#text":902},{"@_ref-type":845,"@_rid":904},{"#text":964},"). Additionally, meningoencephalocele has been recently recognized as another etiology in drug-resistant focal epilepsy, which may sometimes show only subtle abnormalities (",{"xref":966,":@":969},[967],{"#text":968},"Saavalainen et al., 2015",{"@_ref-type":845,"@_rid":970},"B61",{"#text":848},{"xref":973,":@":976},[974],{"#text":975},"Tse et al., 2020",{"@_ref-type":845,"@_rid":977},"B76",{"#text":979},"). In cases with encephalocele, constructive interference in steady-state (CISS) imaging may be helpful for detection by enhancing the contrast between brain parenchyma and cerebrospinal fluid (",{"xref":981,":@":984},[982],{"#text":983},"Wang et al., 2017",{"@_ref-type":845,"@_rid":985},"B84",{"#text":987},") (",{"xref":989,":@":992},[990],{"#text":991},"Figure 2",{"@_ref-type":955,"@_rid":993},"F2",{"#text":995},"). On the other hand, we need to keep in mind that the detected abnormalities may not always cause the seizures, in cases with incidental lesions.",{"#text":824},{"fig":998,":@":1056},[999,1000,1004,1005,1049,1050,1055],{"#text":756},{"label":1001},[1002],{"#text":1003},"FIGURE 1",{"#text":756},{"caption":1006},[1007,1008,1048],{"#text":750},{"p":1009},[1010,1012,1016,1018,1022,1024,1028,1030,1034,1036,1040,1042,1046],{"#text":1011},"An overview of visible epileptogenic lesions (red arrows). ",{"bold":1013},[1014],{"#text":1015},"(A)",{"#text":1017}," Hippocampal sclerosis, ",{"bold":1019},[1020],{"#text":1021},"(B)",{"#text":1023}," focal cortical dysplasia, ",{"bold":1025},[1026],{"#text":1027},"(C)",{"#text":1029}," other malformations of cortical development, ",{"bold":1031},[1032],{"#text":1033},"(D)",{"#text":1035}," neoplasms, ",{"bold":1037},[1038],{"#text":1039},"(E)",{"#text":1041}," vascular malformations, and ",{"bold":1043},[1044],{"#text":1045},"(F)",{"#text":1047}," cerebrovascular lesions.",{"#text":756},{"#text":756},{"graphic":1051,":@":1052},[],{"@_xmlns:xlink":1053,"@_xlink:href":1054},"http://www.w3.org/1999/xlink","fnins-15-699176-g001.tif",{"#text":824},{"@_id":956,"@_position":1057},"float",{"#text":824},{"fig":1060,":@":1081},[1061,1062,1066,1067,1075,1076,1080],{"#text":756},{"label":1063},[1064],{"#text":1065},"FIGURE 2",{"#text":756},{"caption":1068},[1069,1070,1074],{"#text":750},{"p":1071},[1072],{"#text":1073},"A case with drug-resistant temporal lobe epilepsy and encephalocele. Constructive interference in steady-state (CISS) imaging was helpful for detection by enhancing the contrast between brain parenchyma and cerebrospinal fluid.",{"#text":756},{"#text":756},{"graphic":1077,":@":1078},[],{"@_xlink:href":1079},"fnins-15-699176-g002.tif",{"#text":824},{"@_id":993,"@_position":1057},{"#text":824},{"p":1084},[1085,1087,1093,1094,1099,1101,1107,1109,1115,1117,1121,1122,1126,1127,1133,1135,1139],{"#text":1086},"It is also important to differentiate epileptogenic lesions, particularly focal cortical dysplasia, from other findings, such as unspecific aging-related changes showing T2 hyperintensity. For that, we need to consider the main features of focal cortical dysplasia, including cortical thickening, blurring of gray–white matter junction, cortical or white matter T2 hyperintensity, and transmantle sign (",{"xref":1088,":@":1091},[1089],{"#text":1090},"De Vito et al., 2021",{"@_ref-type":845,"@_rid":1092},"B16",{"#text":987},{"xref":1095,":@":1098},[1096],{"#text":1097},"Figures 1B",{"@_ref-type":955,"@_rid":956},{"#text":1100},", ",{"xref":1102,":@":1105},[1103],{"#text":1104},"3",{"@_ref-type":955,"@_rid":1106},"F3",{"#text":1108},"). To detect hippocampal sclerosis, which is the most common etiology of temporal lobe epilepsy (",{"xref":1110,":@":1113},[1111],{"#text":1112},"Thom, 2014",{"@_ref-type":845,"@_rid":1114},"B75",{"#text":1116},"), attention should be paid to hippocampal atrophy and T2 hyperintensity, and thinning and blurring of the molecular layer (",{"xref":1118,":@":1120},[1119],{"#text":902},{"@_ref-type":845,"@_rid":904},{"#text":848},{"xref":1123,":@":1125},[1124],{"#text":1090},{"@_ref-type":845,"@_rid":1092},{"#text":987},{"xref":1128,":@":1131},[1129],{"#text":1130},"Figure 4",{"@_ref-type":955,"@_rid":1132},"F4",{"#text":1134},"). As described, epileptogenic lesions are sometimes subtle, and 3D acquisition with reformats is important (",{"xref":1136,":@":1138},[1137],{"#text":1090},{"@_ref-type":845,"@_rid":1092},{"#text":1140},"). Therefore, we should be careful about motion artifact and quality control.",{"#text":824},{"fig":1143,":@":1179},[1144,1145,1149,1150,1173,1174,1178],{"#text":756},{"label":1146},[1147],{"#text":1148},"FIGURE 3",{"#text":756},{"caption":1151},[1152,1153,1172],{"#text":750},{"p":1154},[1155,1157,1160,1162,1165,1167,1170],{"#text":1156},"A case with drug-resistant focal epilepsy, who benefited from the official standard protocol for epilepsy. It was impossible to detect any abnormalities in both coronal and axial 2D fluid-attenuated inversion recovery (FLAIR) images with 3-mm slice thickness ",{"bold":1158},[1159],{"#text":1015},{"#text":1161},", but the 3D FLAIR images revealed findings of a bottom-of-sulcus-type focal cortical dysplasia with transmantle sign ",{"bold":1163},[1164],{"#text":1021},{"#text":1166},", and changing the signal range is sometimes helpful to clearly visualize the lesion ",{"bold":1168},[1169],{"#text":1027},{"#text":1171},". The pathological finding was focal cortical dysplasia type IIb.",{"#text":756},{"#text":756},{"graphic":1175,":@":1176},[],{"@_xlink:href":1177},"fnins-15-699176-g003.tif",{"#text":824},{"@_id":1106,"@_position":1057},{"#text":824},{"fig":1182,":@":1203},[1183,1184,1188,1189,1197,1198,1202],{"#text":756},{"label":1185},[1186],{"#text":1187},"FIGURE 4",{"#text":756},{"caption":1190},[1191,1192,1196],{"#text":750},{"p":1193},[1194],{"#text":1195},"MRI findings in a case with unilateral hippocampal sclerosis (left). The affected hippocampus showed hippocampal atrophy and T2 hyperintensity, and thinning and blurring of the molecular layer, compared with the contralateral side or normal case (right).",{"#text":756},{"#text":756},{"graphic":1199,":@":1200},[],{"@_xlink:href":1201},"fnins-15-699176-g004.tif",{"#text":824},{"@_id":1132,"@_position":1057},{"#text":827},{"@_id":1206},"S2",{"#text":827},{"sec":1209,":@":1267,"anchorId":1268},[1210,1211,1215,1216,1254,1255,1266],{"#text":824},{"title":1212},[1213],{"#text":1214},"Recommendation of the Official Standard Protocol for Epilepsy",{"#text":824},{"p":1217},[1218,1220,1224,1226,1231,1233,1238,1240,1245,1247,1252],{"#text":1219},"In 2019, the International League Against Epilepsy (ILAE) published the official recommendation of structural MRI for epilepsy (",{"xref":1221,":@":1223},[1222],{"#text":902},{"@_ref-type":845,"@_rid":904},{"#text":1225},"). In that, the following protocols were recommended as a standard: 3D millimetric T1-weighted images (T1WI) and fluid-attenuated inversion recovery (FLAIR) images, and 2D submillimetric coronal T2-weighted images (T2WI). ",{"xref":1227,":@":1230},[1228],{"#text":1229},"Figure 3",{"@_ref-type":955,"@_rid":1106},{"#text":1232}," shows a representative case with drug-resistant focal epilepsy, who benefited from 3D millimetric FLAIR images. It was impossible to detect any abnormalities in both coronal and axial 2D FLAIR images with 3-mm slice thickness (",{"xref":1234,":@":1237},[1235],{"#text":1236},"Figure 3A",{"@_ref-type":955,"@_rid":1106},{"#text":1239},"), but the 3D FLAIR images revealed findings of a bottom-of-sulcus-type focal cortical dysplasia with transmantle sign (",{"xref":1241,":@":1244},[1242],{"#text":1243},"Figure 3B",{"@_ref-type":955,"@_rid":1106},{"#text":1246},"), and changing the signal range may sometimes be helpful to clearly visualize the lesion (",{"xref":1248,":@":1251},[1249],{"#text":1250},"Figure 3C",{"@_ref-type":955,"@_rid":1106},{"#text":1253},"). The patient underwent surgical resection, and the pathological result was focal cortical dysplasia type IIb. Thus, the optimal MRI protocol for epilepsy may be able to make the previously invisible lesions visible.",{"#text":824},{"p":1256},[1257,1259,1265],{"#text":1258},"However, even with such optimized protocols, we sometimes encounter patients with visually normal MRI. To detect the conventionally invisible epileptogenic lesions, efforts have been made to seek for useful advanced neuroimaging techniques in drug-resistant focal epilepsy (",{"xref":1260,":@":1263},[1261],{"#text":1262},"Bernasconi and Wang, 2021",{"@_ref-type":845,"@_rid":1264},"B7",{"#text":893},{"#text":827},{"@_id":1268},"S3",{"#text":827},{"sec":1271,":@":1419,"anchorId":1420},[1272,1273,1277,1278,1394,1395,1418],{"#text":824},{"title":1274},[1275],{"#text":1276},"Advanced Structural Imaging",{"#text":824},{"p":1279},[1280,1282,1288,1290,1296,1297,1303,1304,1310,1311,1317,1318,1324,1325,1331,1332,1338,1340,1344,1345,1349,1351,1357,1359,1365,1366,1372,1374,1380,1381,1385,1387,1393],{"#text":1281},"Beyond the recommended MRI protocol, newer structural MRI sequences have been suggested to provide additional usefulness. Double inversion recovery (DIR), which shows a high contrast between gray and white matters (",{"xref":1283,":@":1286},[1284],{"#text":1285},"Ryan, 2016",{"@_ref-type":845,"@_rid":1287},"B60",{"#text":1289},"), has been increasingly reported as a useful sequence to detect epileptogenic lesions in temporal lobe epilepsy (TLE) and extratemporal focal epilepsy (",{"xref":1291,":@":1294},[1292],{"#text":1293},"Li et al., 2011",{"@_ref-type":845,"@_rid":1295},"B42",{"#text":848},{"xref":1298,":@":1301},[1299],{"#text":1300},"Morimoto et al., 2013a",{"@_ref-type":845,"@_rid":1302},"B50",{"#text":1100},{"xref":1305,":@":1308},[1306],{"#text":1307},"b",{"@_ref-type":845,"@_rid":1309},"B51",{"#text":848},{"xref":1312,":@":1315},[1313],{"#text":1314},"Granata et al., 2016",{"@_ref-type":845,"@_rid":1316},"B23",{"#text":848},{"xref":1319,":@":1322},[1320],{"#text":1321},"Wong-Kisiel et al., 2016",{"@_ref-type":845,"@_rid":1323},"B89",{"#text":848},{"xref":1326,":@":1329},[1327],{"#text":1328},"Wychowski et al., 2016",{"@_ref-type":845,"@_rid":1330},"B90",{"#text":848},{"xref":1333,":@":1336},[1334],{"#text":1335},"Sone et al., 2021",{"@_ref-type":845,"@_rid":1337},"B70",{"#text":1339},"). In TLE, the superiority of DIR to FLAIR for the detection of anterior temporal white matter abnormalities in the focus side in TLE was reported by both qualitative and quantitative evaluations (",{"xref":1341,":@":1343},[1342],{"#text":1300},{"@_ref-type":845,"@_rid":1302},{"#text":848},{"xref":1346,":@":1348},[1347],{"#text":1335},{"@_ref-type":845,"@_rid":1337},{"#text":1350},"). ",{"xref":1352,":@":1355},[1353],{"#text":1354},"Figure 5",{"@_ref-type":955,"@_rid":1356},"F5",{"#text":1358}," describes a case of conventionally MRI-negative PET-positive unilateral TLE, in which increased DIR signals can be found in the focus side, while it was difficult to detect on FLAIR, T1WI, and T2WI. More recently, fluid and white matter suppression (FLAWS) has been reported for better visualization of focal cortical dysplasia even in conventionally MRI-negative cases (",{"xref":1360,":@":1363},[1361],{"#text":1362},"Chen et al., 2018a",{"@_ref-type":845,"@_rid":1364},"B10",{"#text":848},{"xref":1367,":@":1370},[1368],{"#text":1369},"Sun et al., 2021",{"@_ref-type":845,"@_rid":1371},"B72",{"#text":1373},"). FLAWS suppresses the white matter and cerebrospinal fluid signals and then generate gray matter-specific images (",{"xref":1375,":@":1378},[1376],{"#text":1377},"Tanner et al., 2012",{"@_ref-type":845,"@_rid":1379},"B74",{"#text":848},{"xref":1382,":@":1384},[1383],{"#text":1362},{"@_ref-type":845,"@_rid":1364},{"#text":1386},"). Thus, the enhanced contrast between gray and white matters by these newer sequences may improve the visualization of epileptic foci. In addition, edge-enhancing gradient echo (EDGE) imaging was reported to allow us to detect focal cortical dysplasia by directly visualizing the boundary between gray and white matters (",{"xref":1388,":@":1391},[1389],{"#text":1390},"Middlebrooks et al., 2020",{"@_ref-type":845,"@_rid":1392},"B49",{"#text":893},{"#text":824},{"fig":1396,":@":1417},[1397,1398,1402,1403,1411,1412,1416],{"#text":756},{"label":1399},[1400],{"#text":1401},"FIGURE 5",{"#text":756},{"caption":1404},[1405,1406,1410],{"#text":750},{"p":1407},[1408],{"#text":1409},"A case of conventionally MRI-negative PET-positive temporal lobe epilepsy (TLE). While it was difficult to detect abnormalities on FLAIR, double inversion recovery (DIR) visualized hyperintensity within the anterior temporal white matter of the focus side. T1-weighted images (T1WI) and T2WI were also intact including the hippocampus.",{"#text":756},{"#text":756},{"graphic":1413,":@":1414},[],{"@_xlink:href":1415},"fnins-15-699176-g005.tif",{"#text":824},{"@_id":1356,"@_position":1057},{"#text":827},{"@_id":1420},"S4",{"#text":827},{"sec":1423,":@":1615,"anchorId":1616},[1424,1425,1429,1430,1567,1568,1614],{"#text":824},{"title":1426},[1427],{"#text":1428},"Advanced Diffusion Imaging",{"#text":824},{"p":1431},[1432,1434,1440,1441,1447,1448,1454,1455,1461,1463,1469,1470,1476,1477,1483,1484,1490,1491,1497,1498,1504,1505,1511,1512,1518,1520,1524,1525,1529,1531,1535,1536,1542,1544,1548,1550,1554,1556,1560,1561,1565],{"#text":1433},"The progress in diffusion MRI has been an emerging topic in the field of neurology and psychiatry. Particularly, multi-shell protocols of diffusion MRI, including diffusion kurtosis imaging (DKI), q-space imaging (QSI), restriction spectrum imaging (RSI), and neurite orientation dispersion and density imaging (NODDI), have provided further information on brain microstructures (",{"xref":1435,":@":1438},[1436],{"#text":1437},"Cohen and Assaf, 2002",{"@_ref-type":845,"@_rid":1439},"B14",{"#text":848},{"xref":1442,":@":1445},[1443],{"#text":1444},"Jensen et al., 2005",{"@_ref-type":845,"@_rid":1446},"B30",{"#text":848},{"xref":1449,":@":1452},[1450],{"#text":1451},"White et al., 2013",{"@_ref-type":845,"@_rid":1453},"B85",{"#text":848},{"xref":1456,":@":1459},[1457],{"#text":1458},"Sone, 2019",{"@_ref-type":845,"@_rid":1460},"B67",{"#text":1462},"). In the field of epilepsy, NODDI and RSI have been repeatedly reported for their usefulness (",{"xref":1464,":@":1467},[1465],{"#text":1466},"Winston et al., 2014",{"@_ref-type":845,"@_rid":1468},"B87",{"#text":848},{"xref":1471,":@":1474},[1472],{"#text":1473},"Loi et al., 2016",{"@_ref-type":845,"@_rid":1475},"B44",{"#text":848},{"xref":1478,":@":1481},[1479],{"#text":1480},"Reyes et al., 2018",{"@_ref-type":845,"@_rid":1482},"B56",{"#text":848},{"xref":1485,":@":1488},[1486],{"#text":1487},"Rostampour et al., 2018",{"@_ref-type":845,"@_rid":1489},"B57",{"#text":848},{"xref":1492,":@":1495},[1493],{"#text":1494},"Sone et al., 2018",{"@_ref-type":845,"@_rid":1496},"B71",{"#text":848},{"xref":1499,":@":1502},[1500],{"#text":1501},"Lorio et al., 2020",{"@_ref-type":845,"@_rid":1503},"B45",{"#text":848},{"xref":1506,":@":1509},[1507],{"#text":1508},"Winston et al., 2020",{"@_ref-type":845,"@_rid":1510},"B88",{"#text":848},{"xref":1513,":@":1516},[1514],{"#text":1515},"Shao et al., 2021",{"@_ref-type":845,"@_rid":1517},"B64",{"#text":1519},"). Neurite orientation dispersion and density imaging allows us to investigate neurite density and orientation dispersion of the brain microstructures, and reduced neurite density has been consistently found in visible focal cortical dysplasia (",{"xref":1521,":@":1523},[1522],{"#text":1466},{"@_ref-type":845,"@_rid":1468},{"#text":848},{"xref":1526,":@":1528},[1527],{"#text":1501},{"@_ref-type":845,"@_rid":1503},{"#text":1530},"). Neurite orientation dispersion and density imaging may also visualize neurite abnormalities within the focus even in MRI-negative cases (",{"xref":1532,":@":1534},[1533],{"#text":1494},{"@_ref-type":845,"@_rid":1496},{"#text":1350},{"xref":1537,":@":1540},[1538],{"#text":1539},"Figure 6",{"@_ref-type":955,"@_rid":1541},"F6",{"#text":1543}," represents two cases with conventionally MRI-negative PET-positive unilateral TLE, which showed reduced neurite density within the anterior temporal lobe of the focus side. In TLE with hippocampal sclerosis, reductions of neurite orientation dispersion as well as neurite density were reported (",{"xref":1545,":@":1547},[1546],{"#text":1494},{"@_ref-type":845,"@_rid":1496},{"#text":1549},"). Additionally, NODDI could help in better visualization of cortical tubers in tuberous sclerosis (",{"xref":1551,":@":1553},[1552],{"#text":1515},{"@_ref-type":845,"@_rid":1517},{"#text":1555},"). RSI is another advanced diffusion MRI using multi-shell, reduced neurite density, and its correlation with clinical symptoms in epilepsy was also confirmed by RSI (",{"xref":1557,":@":1559},[1558],{"#text":1473},{"@_ref-type":845,"@_rid":1475},{"#text":848},{"xref":1562,":@":1564},[1563],{"#text":1480},{"@_ref-type":845,"@_rid":1482},{"#text":1566},"). Thus, advances in diffusion MRI may be a promising tool for patients with drug-resistant focal epilepsy and invisible lesions on conventional MRI.",{"#text":824},{"fig":1569,":@":1613},[1570,1571,1575,1576,1607,1608,1612],{"#text":756},{"label":1572},[1573],{"#text":1574},"FIGURE 6",{"#text":756},{"caption":1577},[1578,1579,1606],{"#text":750},{"p":1580},[1581,1583,1586,1588,1593,1595,1598,1599,1604],{"#text":1582},"Two cases of conventionally MRI-negative PET-positive TLE. While no abnormalities were found in FLAIR and T2WI including the hippocampus, neurite orientation dispersion and density imaging (NODDI) revealed reduced neurite density of the focus side. ",{"bold":1584},[1585],{"#text":1015},{"#text":1587}," Modified from ",{"xref":1589,":@":1592},[1590],{"#text":1591},"Sone et al. (2018)",{"@_ref-type":845,"@_rid":1496},{"#text":1594},". ",{"bold":1596},[1597],{"#text":1021},{"#text":1587},{"xref":1600,":@":1603},[1601],{"#text":1602},"Sone (2019)",{"@_ref-type":845,"@_rid":1460},{"#text":1605},".",{"#text":756},{"#text":756},{"graphic":1609,":@":1610},[],{"@_xlink:href":1611},"fnins-15-699176-g006.tif",{"#text":824},{"@_id":1541,"@_position":1057},{"#text":827},{"@_id":1616},"S5",{"#text":827},{"sec":1619,":@":1765,"anchorId":1766},[1620,1621,1625,1626,1735,1736,1764],{"#text":824},{"title":1622},[1623],{"#text":1624},"Advanced Functional Neuroimaging",{"#text":824},{"p":1627},[1628,1630,1634,1636,1642,1643,1649,1651,1657,1659,1665,1666,1672,1673,1679,1680,1686,1687,1693,1694,1700,1702,1705,1707,1711,1713,1719,1721,1727,1728,1734],{"#text":1629},"Interictal reduction of glucose metabolisms in ",{"sup":1631},[1632],{"#text":1633},"18",{"#text":1635},"F-FDG PET and ictal hyperperfusion detected by SPECT are traditional and established biomarkers for the detection of focus in drug-resistant epilepsy and often effective for MRI-negative cases (",{"xref":1637,":@":1640},[1638],{"#text":1639},"Kumar and Chugani, 2013",{"@_ref-type":845,"@_rid":1641},"B37",{"#text":848},{"xref":1644,":@":1647},[1645],{"#text":1646},"Shigemoto et al., 2020",{"@_ref-type":845,"@_rid":1648},"B65",{"#text":1650},"). In addition to nuclear imaging, recent advances in functional neuroimaging may further improve the detection of focus. Arterial spin labeling (ASL) is a non-invasive method to visualize brain perfusion by MRI (",{"xref":1652,":@":1655},[1653],{"#text":1654},"Haller et al., 2016",{"@_ref-type":845,"@_rid":1656},"B24",{"#text":1658},") and, thus, expected to detect abnormal cerebral blood flow, particularly interictal reduction, around the epileptogenic foci in epilepsy (",{"xref":1660,":@":1663},[1661],{"#text":1662},"Figure 7",{"@_ref-type":955,"@_rid":1664},"F7",{"#text":987},{"xref":1667,":@":1670},[1668],{"#text":1669},"Boscolo Galazzo et al., 2016",{"@_ref-type":845,"@_rid":1671},"B9",{"#text":848},{"xref":1674,":@":1677},[1675],{"#text":1676},"Shang et al., 2018",{"@_ref-type":845,"@_rid":1678},"B63",{"#text":848},{"xref":1681,":@":1684},[1682],{"#text":1683},"Wang et al., 2018",{"@_ref-type":845,"@_rid":1685},"B82",{"#text":848},{"xref":1688,":@":1691},[1689],{"#text":1690},"Sone et al., 2019",{"@_ref-type":845,"@_rid":1692},"B69",{"#text":848},{"xref":1695,":@":1698},[1696],{"#text":1697},"Lam et al., 2020",{"@_ref-type":845,"@_rid":1699},"B40",{"#text":1701},"). Although ASL might not surpass ",{"sup":1703},[1704],{"#text":1633},{"#text":1706},"F-FDG PET in terms of detectability of focus (",{"xref":1708,":@":1710},[1709],{"#text":1690},{"@_ref-type":845,"@_rid":1692},{"#text":1712},"), its non-invasive nature and wide availability will guarantee a supplemental role in clinical practice. Functional MRI triggered by electroencephalogram (EEG-fMRI) is another newer tool of functional imaging for focus detection. EEG-fMRI can non-invasively detect the hemodynamic signals related with interictal epileptic discharges on EEG (",{"xref":1714,":@":1717},[1715],{"#text":1716},"van Graan et al., 2015",{"@_ref-type":845,"@_rid":1718},"B77",{"#text":1720},"), and then it can be utilized to visualize the epileptogenic zone and its propagations (",{"xref":1722,":@":1725},[1723],{"#text":1724},"Khoo et al., 2017",{"@_ref-type":845,"@_rid":1726},"B33",{"#text":1100},{"xref":1729,":@":1732},[1730],{"#text":1731},"2018",{"@_ref-type":845,"@_rid":1733},"B34",{"#text":893},{"#text":824},{"fig":1737,":@":1763},[1738,1739,1743,1744,1757,1758,1762],{"#text":756},{"label":1740},[1741],{"#text":1742},"FIGURE 7",{"#text":756},{"caption":1745},[1746,1747,1756],{"#text":750},{"p":1748},[1749,1751,1755],{"#text":1750},"A case of temporal lobe epilepsy with hippocampal sclerosis. Both Arterial spin labeling (ASL) and 18F-FDG PET showed reduced signals around the temporal lobe of focus side (modified from ",{"xref":1752,":@":1754},[1753],{"#text":1690},{"@_ref-type":845,"@_rid":1692},{"#text":893},{"#text":756},{"#text":756},{"graphic":1759,":@":1760},[],{"@_xlink:href":1761},"fnins-15-699176-g007.tif",{"#text":824},{"@_id":1664,"@_position":1057},{"#text":827},{"@_id":1766},"S6",{"#text":827},{"sec":1769,":@":1975,"anchorId":1976},[1770,1771,1775,1776,1868,1869,1974],{"#text":824},{"title":1772},[1773],{"#text":1774},"Quantitative Analysis and Post-Processing",{"#text":824},{"p":1777},[1778,1780,1786,1788,1794,1795,1801,1803,1809,1810,1816,1817,1823,1824,1830,1831,1837,1838,1844,1846,1852,1854,1860,1861,1867],{"#text":1779},"Another solution for MRI-negative drug-resistant epilepsy is quantitative analysis and post-processing of images. It is known that quantitative hippocampal volumetry and signal analysis improve the visual detectability of hippocampal sclerosis (",{"xref":1781,":@":1784},[1782],{"#text":1783},"Coan et al., 2014",{"@_ref-type":845,"@_rid":1785},"B13",{"#text":1787},"), and better segmentation and detailed hippocampal profiling methods have also been developed (",{"xref":1789,":@":1792},[1790],{"#text":1791},"Winston et al., 2013",{"@_ref-type":845,"@_rid":1793},"B86",{"#text":848},{"xref":1796,":@":1799},[1797],{"#text":1798},"Vos et al., 2020",{"@_ref-type":845,"@_rid":1800},"B80",{"#text":1802},"). The Morphometric Analysis Program (MAP) is a well-investigated software to generate voxel-based morphometric maps, which can visualize subtle blurring of the gray–white boundary or abnormal cortical surface, using 3D T1WI. In fact, many studies confirmed the usefulness of MAP for the detection of focal cortical dysplasia (",{"xref":1804,":@":1807},[1805],{"#text":1806},"Kassubek et al., 2002",{"@_ref-type":845,"@_rid":1808},"B32",{"#text":848},{"xref":1811,":@":1814},[1812],{"#text":1813},"Huppertz et al., 2005",{"@_ref-type":845,"@_rid":1815},"B27",{"#text":848},{"xref":1818,":@":1821},[1819],{"#text":1820},"Wagner et al., 2011",{"@_ref-type":845,"@_rid":1822},"B81",{"#text":848},{"xref":1825,":@":1828},[1826],{"#text":1827},"Wang et al., 2015",{"@_ref-type":845,"@_rid":1829},"B83",{"#text":848},{"xref":1832,":@":1835},[1833],{"#text":1834},"Lin et al., 2018",{"@_ref-type":845,"@_rid":1836},"B43",{"#text":848},{"xref":1839,":@":1842},[1840],{"#text":1841},"Demerath et al., 2020",{"@_ref-type":845,"@_rid":1843},"B17",{"#text":1845},") or band heterotopia (",{"xref":1847,":@":1850},[1848],{"#text":1849},"Huppertz et al., 2008",{"@_ref-type":845,"@_rid":1851},"B28",{"#text":1853},"). In addition to T1WI, usefulness of quantitative FLAIR or DIR analysis was also reported (",{"xref":1855,":@":1858},[1856],{"#text":1857},"Rugg-Gunn et al., 2006",{"@_ref-type":845,"@_rid":1859},"B59",{"#text":848},{"xref":1862,":@":1865},[1863],{"#text":1864},"Focke et al., 2009",{"@_ref-type":845,"@_rid":1866},"B20",{"#text":893},{"#text":824},{"p":1870},[1871,1873,1879,1880,1886,1887,1893,1894,1899,1901,1907,1908,1914,1915,1921,1922,1928,1930,1936,1938,1944,1946,1952,1953,1959,1960,1966,1967,1973],{"#text":1872},"Machine learning is an emerging topic in this field; the advantage of machine-learning may include the accurate, automated, and fast pattern learning, which could be utilized to develop and/optimize clinical algorithms. Currently, studies on machine learning and epilepsy imaging reported its usefulness in the lateralization of TLE (",{"xref":1874,":@":1877},[1875],{"#text":1876},"Pustina et al., 2015",{"@_ref-type":845,"@_rid":1878},"B53",{"#text":848},{"xref":1881,":@":1884},[1882],{"#text":1883},"Bennett et al., 2019",{"@_ref-type":845,"@_rid":1885},"B5",{"#text":848},{"xref":1888,":@":1891},[1889],{"#text":1890},"Beheshti et al., 2020a",{"@_ref-type":845,"@_rid":1892},"B3",{"#text":1100},{"xref":1895,":@":1897},[1896],{"#text":1307},{"@_ref-type":845,"@_rid":1898},"B4",{"#text":1900},") or automated detection of focal cortical dysplasia (",{"xref":1902,":@":1905},[1903],{"#text":1904},"Hong et al., 2014",{"@_ref-type":845,"@_rid":1906},"B26",{"#text":848},{"xref":1909,":@":1912},[1910],{"#text":1911},"Hong et al., 2016",{"@_ref-type":845,"@_rid":1913},"B25",{"#text":848},{"xref":1916,":@":1919},[1917],{"#text":1918},"Adler et al., 2017",{"@_ref-type":845,"@_rid":1920},"B1",{"#text":848},{"xref":1923,":@":1926},[1924],{"#text":1925},"Tan et al., 2018",{"@_ref-type":845,"@_rid":1927},"B73",{"#text":1929},"). While machine leaning has provided promising results for the detection of focus in epilepsy, we may need to develop and validate consistent methodology given the diversity of methods (",{"xref":1931,":@":1934},[1932],{"#text":1933},"Sone and Beheshti, 2021",{"@_ref-type":845,"@_rid":1935},"B68",{"#text":1937},"). Furthermore, network analysis is another trend in epilepsy (",{"xref":1939,":@":1942},[1940],{"#text":1941},"Bernhardt et al., 2015",{"@_ref-type":845,"@_rid":1943},"B8",{"#text":1945},"), and literature suggested that network metrics derived from neuroimaging could also be used for focus detection when combined with machine learning (",{"xref":1947,":@":1950},[1948],{"#text":1949},"Chiang et al., 2015",{"@_ref-type":845,"@_rid":1951},"B12",{"#text":848},{"xref":1954,":@":1957},[1955],{"#text":1956},"Yang et al., 2015",{"@_ref-type":845,"@_rid":1958},"B91",{"#text":848},{"xref":1961,":@":1964},[1962],{"#text":1963},"Kamiya et al., 2016",{"@_ref-type":845,"@_rid":1965},"B31",{"#text":848},{"xref":1968,":@":1971},[1969],{"#text":1970},"Fallahi et al., 2020",{"@_ref-type":845,"@_rid":1972},"B18",{"#text":893},{"#text":827},{"@_id":1976},"S7",{"#text":827},{"sec":1979,":@":2037,"anchorId":2038},[1980,1981,1985,1986,2036],{"#text":824},{"title":1982},[1983],{"#text":1984},"Multimodal Imaging",{"#text":824},{"p":1987},[1988,1990,1996,1998,2002,2004,2007,2009,2015,2017,2021,2022,2026,2028,2034],{"#text":1989},"Combination of multimodal imaging is also important for precise localization of focus (",{"xref":1991,":@":1994},[1992],{"#text":1993},"Kurian et al., 2007",{"@_ref-type":845,"@_rid":1995},"B38",{"#text":1997},"). Concordance across different modalities supports successful epilepsy surgery (",{"xref":1999,":@":2001},[2000],{"#text":889},{"@_ref-type":845,"@_rid":891},{"#text":2003},"), and in addition, coregistered images would improve visual detectability of epileptogenic foci, which was demonstrated by a study using MRI and ",{"sup":2005},[2006],{"#text":1633},{"#text":2008},"F-FDG PET (",{"xref":2010,":@":2013},[2011],{"#text":2012},"Salamon et al., 2008",{"@_ref-type":845,"@_rid":2014},"B62",{"#text":2016},"). Multimodal imaging is also a topic in machine learning studies (",{"xref":2018,":@":2020},[2019],{"#text":1876},{"@_ref-type":845,"@_rid":1878},{"#text":848},{"xref":2023,":@":2025},[2024],{"#text":1883},{"@_ref-type":845,"@_rid":1885},{"#text":2027},"). Given the importance of multiple modalities in epilepsy, developing a platform for fusion of data (",{"xref":2029,":@":2032},[2030],{"#text":2031},"Marecek et al., 2021",{"@_ref-type":845,"@_rid":2033},"B46",{"#text":2035},") would become a significant work for the future.",{"#text":827},{"@_id":2038},"S8",{"#text":827},{"sec":2041,":@":2096,"anchorId":2097},[2042,2043,2047,2048,2095],{"#text":824},{"title":2044},[2045],{"#text":2046},"Seven-Tesla MRI",{"#text":824},{"p":2049},[2050,2052,2058,2060,2066,2067,2073,2074,2080,2081,2087,2089,2093],{"#text":2051},"Seven-tesla (7T) MRI is expected to yield improved detectability over 3T MRI, by the ultra-high-field magnetic strength (",{"xref":2053,":@":2056},[2054],{"#text":2055},"van Lanen et al., 2021",{"@_ref-type":845,"@_rid":2057},"B78",{"#text":2059},"). Despite the still limited access to 7T MRI, there have been several studies reporting its usefulness in epilepsy (",{"xref":2061,":@":2064},[2062],{"#text":2063},"De Ciantis et al., 2016",{"@_ref-type":845,"@_rid":2065},"B15",{"#text":848},{"xref":2068,":@":2071},[2069],{"#text":2070},"Veersema et al., 2017",{"@_ref-type":845,"@_rid":2072},"B79",{"#text":848},{"xref":2075,":@":2078},[2076],{"#text":2077},"Bartolini et al., 2019",{"@_ref-type":845,"@_rid":2079},"B2",{"#text":848},{"xref":2082,":@":2085},[2083],{"#text":2084},"Feldman et al., 2019",{"@_ref-type":845,"@_rid":2086},"B19",{"#text":2088},"). On the other hand, diagnostic gain of 7T over conventional MRI has been variable, ranging from 8 to 67% (",{"xref":2090,":@":2092},[2091],{"#text":2055},{"@_ref-type":845,"@_rid":2057},{"#text":2094},"), and thus, further studies would be needed to establish the utility of 7T MRI for clinical use in patients with epilepsy.",{"#text":827},{"@_id":2097},"S9",{"#text":827},{"sec":2100,":@":2170,"anchorId":2171},[2101,2102,2106,2107,2111,2112,2169],{"#text":824},{"title":2103},[2104],{"#text":2105},"Establishment of Clinical MRI Standards for Epilepsy",{"#text":824},{"p":2108},[2109],{"#text":2110},"While this review focused on the recent progress in newer imaging techniques, uniformity of the MRI protocols is of great relevance in clinical epileptology. To establish a practical standard, various aspects need to be considered, including magnetic field strength, imaging resolution, and acquisition time.",{"#text":824},{"p":2113},[2114,2116,2122,2123,2127,2129,2135,2136,2142,2143,2149,2150,2156,2158,2162,2164,2167],{"#text":2115},"Regarding the magnetic field strength, 1.5- or 3-T MRI scanners are currently utilized in clinical practice. In principle, 3-T MRI provides a better signal-to-noise ratio and higher resolution of images, although we need to pay more careful attention to flow and motion artifact in 3-T scanners (",{"xref":2117,":@":2120},[2118],{"#text":2119},"Martinez-Rios et al., 2016",{"@_ref-type":845,"@_rid":2121},"B47",{"#text":848},{"xref":2124,":@":2126},[2125],{"#text":1090},{"@_ref-type":845,"@_rid":1092},{"#text":2128},"). Indeed, some previous studies reported better identification of epileptogenic lesions by 3- than by 1.5-T MRI, and the use of 3-T MRI may improve the clinical decision making (",{"xref":2130,":@":2133},[2131],{"#text":2132},"Knake et al., 2005",{"@_ref-type":845,"@_rid":2134},"B35",{"#text":848},{"xref":2137,":@":2140},[2138],{"#text":2139},"Zijlmans et al., 2009",{"@_ref-type":845,"@_rid":2141},"B92",{"#text":848},{"xref":2144,":@":2147},[2145],{"#text":2146},"Mellerio et al., 2014",{"@_ref-type":845,"@_rid":2148},"B48",{"#text":848},{"xref":2151,":@":2154},[2152],{"#text":2153},"Rubinger et al., 2016",{"@_ref-type":845,"@_rid":2155},"B58",{"#text":2157},"). The imaging resolution should be along with the official recommendation of ILAE (",{"xref":2159,":@":2161},[2160],{"#text":902},{"@_ref-type":845,"@_rid":904},{"#text":2163},"), i.e., 3D isotropic T1WI and FLAIR images with millimetric voxels (1 × 1 × 1 mm",{"sup":2165},[2166],{"#text":1104},{"#text":2168},"), and 2D submillimetric T2WI designed for hippocampal evaluation. More advanced techniques, which were reviewed in this article, may be considered as additional imaging. On the other hand, however, such additions usually require longer acquisition time, which may become a trade-off dilemma for clinically acceptable epilepsy imaging. Thus, those advanced imaging methods need to become more established, particularly by robustly revealing the clinical usefulness, e.g., long-term prognosis of surgery. The manufacturer of MRI scanners is another important factor for the uniformity of epilepsy protocols, as some newer sequences have been developed by each specific manufacturer.",{"#text":827},{"@_id":2171},"S10",{"#text":827},{"sec":2174,":@":2214,"anchorId":2215},[2175,2176,2180,2181,2213],{"#text":824},{"title":2177},[2178],{"#text":2179},"Limitation and Future Challenge",{"#text":824},{"p":2182},[2183,2185,2191,2192,2198,2200,2206,2207,2211],{"#text":2184},"As noted above, compared with conventionally established sequences, the usefulness of advanced imaging still needs to be more robustly elucidated. Although most studies reported potentials of better focus detection, long-term seizure outcomes after resection of the abnormal areas are rarely investigated, so far. Additionally, the cost effectiveness of acquisition time should be kept in mind. Thus, future studies should include more comprehensive and robust comparisons between imaging modalities and clinical parameters, as well as consideration of time efficiency. Another important topic in epilepsy imaging is the preclinical MRI studies to identify the underlying mechanism and time course of epileptogenesis (",{"xref":2186,":@":2189},[2187],{"#text":2188},"Immonen et al., 2019",{"@_ref-type":845,"@_rid":2190},"B29",{"#text":848},{"xref":2193,":@":2196},[2194],{"#text":2195},"Reddy et al., 2019",{"@_ref-type":845,"@_rid":2197},"B55",{"#text":2199},"). Advanced neuroimaging methods may provide further information for basic research on epilepsy. Eventually, in addition to focus detection, neuroimaging could contribute to elucidation of the neurobiological mechanisms, brain functions, and longitudinal brain changes in epilepsy (",{"xref":2201,":@":2204},[2202],{"#text":2203},"Galovic et al., 2019",{"@_ref-type":845,"@_rid":2205},"B21",{"#text":848},{"xref":2208,":@":2210},[2209],{"#text":1262},{"@_ref-type":845,"@_rid":1264},{"#text":2212},"). Thus, clinical and basic applications of advanced neuroimaging would be promising for better understanding and improved clinical practice for epilepsy.",{"#text":827},{"@_id":2215},"S11",{"#text":827},{"sec":2218,":@":2230,"anchorId":2231},[2219,2220,2224,2225,2229],{"#text":824},{"title":2221},[2222],{"#text":2223},"Conclusion",{"#text":824},{"p":2226},[2227],{"#text":2228},"There have been various, continuous efforts to better visualize epileptogenic foci in drug-resistant focal epilepsy. The promising advances in structural, diffusion, and functional neuroimaging, as well as quantitative processing and machine learning, may provide critical information for epilepsy surgery and benefit patients with drug-resistant focal epilepsy.",{"#text":827},{"@_id":2231},"S12",{"#text":827},{"sec":2234,":@":2246},[2235,2236,2240,2241,2245],{"#text":824},{"title":2237},[2238],{"#text":2239},"Author Contributions",{"#text":824},{"p":2242},[2243],{"#text":2244},"DS was the sole author of this manuscript and contributed to all aspects.",{"#text":827},{"@_id":2247},"S13",{"#text":827},{"sec":2250,":@":2262},[2251,2252,2256,2257,2261],{"#text":824},{"title":2253},[2254],{"#text":2255},"Conflict of Interest",{"#text":824},{"p":2258},[2259],{"#text":2260},"The author declares that the research was conducted in the absence of any commercial or financial relationships that could be construed as a potential conflict of interest.",{"#text":827},{"@_sec-type":2263,"@_id":2264},"COI-statement","conf1",{"#text":827},{"sec":2267,":@":2279,"anchorId":2281},[2268,2269,2273,2274,2278],{"#text":824},{"title":2270},[2271],{"#text":2272},"Publisher’s Note",{"#text":824},{"p":2275},[2276],{"#text":2277},"All claims expressed in this article are solely those of the authors and do not necessarily represent those of their affiliated organizations, or those of the publisher, the editors and the reviewers. Any product that may be evaluated in this article, or claim that may be made by its manufacturer, is not guaranteed or endorsed by the publisher.",{"#text":827},{"@_sec-type":2280,"@_id":2281},"disclaimer","S14",{"#text":2283},"\n  ",[],[2286,2299,2314,2324],{"title":2287,"order":2288,"content":2289},"Author contributions",3,[2290,2291,2294,2295,2298],{"#text":824},{"title":2292},[2293],{"#text":2239},{"#text":824},{"p":2296},[2297],{"#text":2244},{"#text":827},{"title":2300,"order":2301,"content":2302},"Funding",5,[2303,2304,2313],{"#text":756},{"p":2305},[2306,2307,2311],{"#text":750},{"bold":2308},[2309],{"#text":2310},"Funding.",{"#text":2312}," This work was supported by the Japan Society for the Promotion of Science (KAKENHI Grant Number JP21K15720) to DS.",{"#text":824},{"title":2315,"order":2316,"content":2317},"Acknowledgments",6,[2318,2319,2323],{"#text":824},{"p":2320},[2321],{"#text":2322},"I am grateful to the colleagues in the Department of Radiology, National Center of Neurology and Psychiatry, Tokyo, Japan.",{"#text":827},{"title":2325,"order":2326,"content":2327},"Conflict of interest",8,[2328,2329,2332,2333,2336],{"#text":824},{"title":2330},[2331],{"#text":2255},{"#text":824},{"p":2334},[2335],{"#text":2260},{"#text":827},[2338],{"title":2339,"id":2340,"references":2341},"References","h16",[2342,2495,2638,2777,2907,3050,3192,3272,3369,3508,3651,3760,3855,3979,4059,4193,4329,4468,4607,4746,4883,5022,5068,5207,5345,5466,5595,5733,5868,6006,6129,6262,6366,6505,6637,6768,6846,6923,7064,7143,7283,7357,7478,7620,7751,7885,8023,8160,8299,8434,8566,8699,8807,8941,9020,9123,9262,9369,9504,9626,9689,9822,9959,10095,10224,10334,10414,10472,10544,10670,10794,10921,11050,11182,11319,11384,11525,11621,11754,11895,12031,12156,12292,12430,12565,12688,12825,12957,13088,13230,13361,13463],{"content":2343,"id":1920,"index":19,"authors":2488,"title":2452,"source":2458,"volume":2462,"year":2447,"fpage":1633,"lpage":2471,"doi":2476,"pmid":2482},[2344,2345,2487],{"#text":756},{"citation":2346,":@":2485},[2347,2348,2442,2444,2448,2449,2453,2459,2463,2466,2468,2472,2473,2479],{"#text":750},{"person-group":2349,":@":2440},[2350,2352,2366,2367,2380,2381,2394,2395,2408,2409,2422,2423,2436,2437,2439],{"#text":2351},"\n            ",{"name":2353},[2354,2356,2360,2361,2365],{"#text":2355},"\n              ",{"surname":2357},[2358],{"#text":2359},"Adler",{"#text":2355},{"given-names":2362},[2363],{"#text":2364},"S.",{"#text":2351},{"#text":2351},{"name":2368},[2369,2370,2374,2375,2379],{"#text":2355},{"surname":2371},[2372],{"#text":2373},"Wagstyl",{