        "steps": [
          {
            "label": "Extra-axial haemorrhage",
            "detail": "Distinguish epidural, subdural and subarachnoid haemorrhage.",
            "sections": [
              "EXTRA-AXIAL BLOOD"
            ],
            "look": "Brain window and a wider subdural window; epidural is biconvex and limited by sutures; subdural is crescentic and crosses sutures.",
            "normal": "No extra-axial haemorrhage.",
            "findings": [
              "Biconvex epidural haematoma over the [right temporal] convexity, __ mm thick, with an overlying fracture.",
              "Crescentic acute subdural haematoma over the [left] convexity, __ mm thick.",
              "Traumatic subarachnoid haemorrhage in the [ ] sulci."
            ],
            "images": [
              "intracranial-haemorrhage-image-1"
            ],
            "measurements": [
              "Haematoma and shift"
            ],
            "landmark": "meninges",
            "parts": [
              "FMA67292",
              "FMA61819"
            ],
            "tip": "An epidural haematoma does not cross sutures; a subdural haematoma does not cross the midline."
          },
          {
            "label": "Parenchymal injury",
            "detail": "Assess contusions, intraparenchymal haematoma and oedema.",
            "sections": [
              "PARENCHYMAL INJURY"
            ],
            "look": "Frontal and temporal poles and inferior surfaces (coup and contrecoup sites).",
            "normal": "No contusion or intraparenchymal haemorrhage.",
            "findings": [
              "Haemorrhagic contusions of the [inferior frontal / anterior temporal] lobes.",
              "Petechial haemorrhages at the grey–white junction and corpus callosum (diffuse axonal injury pattern)."
            ],
            "landmark": "territories",
            "parts": [
              "FMA67292",
              "FMA61819"
            ],
            "tip": "Contusions often enlarge on early follow-up CT."
          },
          {
            "label": "Ventricles",
            "detail": "Identify intraventricular blood and ventricular obstruction.",
            "sections": [
              "VENTRICLES"
            ],
            "look": "Occipital horns for layering blood; ventricular size.",
            "normal": "No intraventricular haemorrhage; ventricles normal.",
            "findings": [
              "Intraventricular blood layering in the occipital horns.",
              "Early hydrocephalus."
            ],
            "landmark": "ventricles",
            "parts": [
              "FJ1814",
              "FJ1767",
              "FJ1730",
              "FJ1731"
            ]
          },
          {
            "label": "Mass effect",
            "detail": "Measure midline shift and assess the basal cisterns and herniation.",
            "sections": [
              "MASS EFFECT"
            ],
            "look": "Midline shift at the level of the septum pellucidum; ambient and quadrigeminal cisterns.",
            "normal": "No midline shift; basal cisterns patent.",
            "findings": [
              "Midline shift of __ mm to the [left].",
              "Effaced basal cisterns with uncal herniation.",
              "Duret haemorrhage in the pons (secondary to descending herniation)."
            ],
            "measurements": [
              "Haematoma and shift"
            ],
            "landmark": "ventricles",
            "parts": [
              "FJ1814",
              "FJ1767",
              "FJ1730",
              "FJ1731"
            ]
          },
          {
            "label": "Skull and comparison",
            "detail": "Review skull and skull-base fractures, pneumocephalus and interval change.",
            "sections": [
