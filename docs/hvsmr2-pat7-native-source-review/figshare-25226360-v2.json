ame": "Gao", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 17972077, "full_name": "mohammad imrul jubair", "first_name": "mohammad imrul", "last_name": "jubair", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 16511185, "full_name": "Tom Yeh", "first_name": "Tom", "last_name": "Yeh", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14011177, "full_name": "Polina Golland", "first_name": "Polina", "last_name": "Golland", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 16511187, "full_name": "Tal Geva", "first_name": "Tal", "last_name": "Geva", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 16511188, "full_name": "Sunil Ghelani", "first_name": "Sunil", "last_name": "Ghelani", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 16511189, "full_name": "Andrew Powell", "first_name": "Andrew", "last_name": "Powell", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 16426749, "full_name": "mehdi hedjazi moghari", "first_name": "mehdi hedjazi", "last_name": "moghari", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/dataset/HVSMR-2_0_orig_/25226360", "download_disabled": false, "description": "<p dir=\"ltr\"><b>HVSMR-2.0: A 3D cardiovascular MR dataset for whole-heart segmentation in congenital heart disease</b></p><p dir=\"ltr\">Patients with congenital heart disease often have cardiac anatomy that deviates significantly from normal, frequently requiring multiple heart surgeries. Image segmentation from a preoperative cardiovascular magnetic resonance (CMR) scan would enable creation of patient-specific 3D surface models of the heart, which have potential to improve surgical planning, enable surgical simulation, and allow automatic computation of quantitative metrics of heart function. However, there is no publicly available CMR dataset for whole-heart segmentation in patients with congenital heart disease. Here, we release the HVSMR-2.0 dataset, comprising 60 CMR scans alongside manual segmentation masks of the 4 cardiac chambers and 4 great vessels. The images showcase a wide range of heart defects and prior surgical interventions. The dataset also includes masks of required and optional extents of the great vessels, enabling fairer comparisons across algorithms. Detailed diagnoses for each subject are also provided. By releasing HVSMR-2.0, we aim to encourage development of robust segmentation algorithms and clinically relevant tools for congenital heart disease.</p><p dir=\"ltr\"><i>orig</i>: CMR images <i>pat#_orig.nii.gz</i> manually cropped at the chin, with original spacing and no normalization, with corresponding whole-heart segmentations <i>pat#_orig_seg.nii.gz</i> and endpoints files <i>pat#_orig_seg_endpoints.nii.gz</i>.</p>", "funding": null, "funding_list": [], "version": 2, "status": "public", "size": 1777744715, "created_date": "2024-02-15T20:57:54Z", "modified_date": "2024-05-13T17:46:37Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["cardiovascular magnetic resonance imaging", "congenital heart disease", "image segmentation"], "keywords": ["cardiovascular magnetic resonance imaging", "congenital heart disease", "image segmentation"], "categories": [{"id": 24463, "title": "Cardiology (incl. cardiovascular diseases)", "parent_id": 24460, "path": "/24457/24460/24463", "source_id": "320101", "taxonomy_id": 100}, {"id": 28879, "title": "Computer vision", "parent_id": 28867, "path": "/28798/28867/28879", "source_id": "460304", "taxonomy_id": 100}, {"id": 26275, "title": "Biomedical imaging", "parent_id": 26263, "path": "/26212/26263/26275", "source_id": "400304", "taxonomy_id": 100}], "references": [], "has_linked_file": false, "citation": "Pace, Danielle; Contreras, Hannah; Romanowicz, Jennifer; Ghelani, Shruti; Rahaman, Imon; Zhang, Yue; et al. (2024). HVSMR-2.0 (orig). figshare. Dataset. https://doi.org/10.6084/m9.figshare.25226360.v2", "related_materials": [], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 25226360, "title": "HVSMR-2.0 (orig)", "doi": "10.6084/m9.figshare.25226360.v2", "handle": "", "url": "https://api.figshare.com/v2/articles/25226360", "published_date": "2024-02-15T20:57:54Z", "thumb": "", "defined_type": 3, "defined_type_name": "dataset", "group_id": null, "url_private_api": "https://api.figshare.com/v2/account/articles/25226360", "url_public_api": "https://api.figshare.com/v2/articles/25226360", "url_private_html": "https://figshare.com/account/articles/25226360", "timeline": {"posted": "2024-02-15T20:57:54", "firstOnline": "2024-02-15"}, "resource_title": null, "resource_doi": null}