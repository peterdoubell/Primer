# Never upload the reader's data or the gigabyte archives.
content
data/primer.db
data/primer.db-shm
data/primer.db-wal
**/*.db
**/*.db-shm
**/*.db-wal
.env*
**/.env*

# Local duplicate/recovery copies are not runtime assets.
**/* 2.*
**/* 3.*
**/.DS_Store

# Not needed at runtime
.git
.venv
.pytest_cache
__pycache__
tests
tools
BOARD.md
.claude
.agents
.github
docs/*
artifacts

# Offline research and generation staging are not application assets.
output
outputs
tmp

# Runtime validates this cross-topic source scope fingerprint.
!docs/msk-hamstring-shared-figures.md

# Local anatomy source downloads and research dependencies.
.research
.research/

# Offline fidelity inventories and review evidence are used by tools/tests only.
data/radiology/msk-asset-evidence.json
data/radiology/msk-structure-requirements.json
data/radiology/non-msk-structure-requirements.json
data/radiology/radiology-asset-evidence.json

# Lossless anatomy arrays are pinned and verified in public Blob storage.
web/anatomy/brain-fine-massp2/*.gz

# Complete licensed publication originals are pinned in public Blob storage.
web/reference-media/radiology-open/traumatic-haemorrhage
web/reference-media/radiology-open/traumatic-haemorrhage/*

# Reviewed stroke sources are byte-pinned in public Blob storage.
web/reference-media/radiology-open/acute-stroke
web/reference-media/radiology-open/acute-stroke/*
web/anatomy/soop-stroke-sub342/*.gz
web/anatomy/soop-stroke-sub342/sub-342*.json

# Complete pulmonary CT and released annotations use reviewed fixed Blob paths.
# The three authored viewer/manifest files remain authenticated runtime files.
web/anatomy/lidc-idri-0525/original-ct
web/anatomy/lidc-idri-0525/original-ct/*
web/anatomy/lidc-idri-0525/*.gz
web/anatomy/lidc-idri-0525/source-*.zip
web/anatomy/lidc-idri-0525/original-0525.xml
web/anatomy/lidc-idri-0525/ct-source-md5.csv
web/anatomy/lidc-idri-0525/LICENSE
web/anatomy/lidc-idri-0525/ATTRIBUTION.txt

# Original cardiac context registry remains offline; runtime uses byte-verified lossless gzip.
data/radiology/cardiac-wall-context.json

# Report authoring sources remain in Git; runtime reads the lossless compiled pack.
data/radiology/msk-anatomic-*.json
data/radiology/descriptor-reporting.json
# Authoring definitions and historical exports are not used by the Primer runtime.
data/radiology/anatomic-*.json
data/radiology/descriptor-history/
tools/authoring/
