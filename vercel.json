{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{public/**,web/anatomy/{bodyparts3d,msk-atlas,msk-cervical,msk-mri-knee,msk-mri-ankle,liu-lumbosacral-sub03,verse521,hvsmr2-pat7,openear-zeta,totalseg-v3-s0358,totalseg-v3-esophagus-s0358,ispy1-expert1002}/**/*.bin,web/anatomy/{bodyparts3d,msk-atlas,msk-cervical,msk-mri-knee,msk-mri-ankle,liu-lumbosacral-sub03,verse521,hvsmr2-pat7,openear-zeta,totalseg-v3-s0358,totalseg-v3-esophagus-s0358,ispy1-expert1002}/**/*.bin.gz,web/reference-media/prenatal-development/prenatal-development.gif,web/reference-media/prenatal-development/day-*.webp,web/illustrations/**/*.webp,web/reference-media/radiology-open/**/*.{jpg,jpeg,png,webp,gif},web/reference-media/radiology-motion/**,web/anatomy/totalseg-v3-esophagus-s0358/ct-reference.html,web/anatomy/ispy1-expert1002/mri-reference.html}"
      }
    },
    {
      "src": "web/anatomy/{bodyparts3d,msk-atlas,msk-cervical,msk-mri-knee,msk-mri-ankle,liu-lumbosacral-sub03,verse521,hvsmr2-pat7,openear-zeta,totalseg-v3-s0358,totalseg-v3-esophagus-s0358,ispy1-expert1002}/**/*.bin*",
      "use": "@vercel/static"
    },
    {
      "src": "web/reference-media/prenatal-development/prenatal-development.gif",
      "use": "@vercel/static"
    },
    {
      "src": "web/reference-media/prenatal-development/day-*.webp",
      "use": "@vercel/static"
    },
    {
      "src": "web/anatomy/{verse521,totalseg-v3-s0358,totalseg-v3-esophagus-s0358,ispy1-expert1002}/ct-reference.html",
      "use": "@vercel/static"
    },
    {
      "src": "web/illustrations/**/*.webp",
      "use": "@vercel/static"
    },
    {
      "src": "web/reference-media/radiology-open/**",
      "use": "@vercel/static"
    },
    {
      "src": "web/reference-media/radiology-motion/**",
      "use": "@vercel/static"
    },
    {
      "src": "web/anatomy/ispy1-expert1002/mri-reference.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/source-media/(.*\\.bin\\.gz)",
      "dest": "/web/$1",
      "headers": {
        "Content-Type": "application/octet-stream",
        "Content-Encoding": "gzip"
      }
    },
    {
      "src": "/source-media/(.*)",
      "dest": "/web/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
